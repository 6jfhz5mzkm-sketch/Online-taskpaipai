# ============================================================
# 拍拍二手资费同步自动化 · 环境变量样例
# 复制为 automation/.env 并填写实际值（.env 勿提交 git）
# 未配置项会回退到 backend/.env.local（DB / 飞书 app 凭证）
# ============================================================

# ---- MySQL（默认取自 backend/.env.local）----
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASS=<填写真实口令；生产禁用 dev 兜底值>
# DB_NAME=merchant_task

# ---- 飞书通知（应用消息发给指定 open_id）----
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# 接收方 open_id（管理层/指定负责人，通知必填，否则无法推送）
# 位置：服务器只放 automation/.env（<SERVER_ROOT>/automation/.env，600）；值属内部标识
# 硬化口径（2026-09-16）：setup-server.sh 不再内置任何默认值；留空 = 显式跳过推送（notify.js 会打印提示）
FEISHU_ADMIN_OPEN_ID=
# 飞书开放平台 base，默认 https://open.feishu.cn
# FEISHU_API_BASE=https://open.feishu.cn

# ---- 规则页 ----
# 目标页面链接，默认拍拍资费标准
# FEE_RULE_URL=https://learn-jdm.jd.com/knowledge/rule/detail?ruleId=1323517376196349952

# ---- 抓取 ----
# 指定浏览器可执行文件路径（可选；为空则自动找系统 Chrome/msedge，否则用 Playwright 自带 chromium）
# FEE_SCRAPE_BROWSER_PATH=
# 无头渲染超时（毫秒）
# FEE_SCRAPE_TIMEOUT_MS=120000
