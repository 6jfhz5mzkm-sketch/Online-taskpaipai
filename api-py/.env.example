# ============================================================
# api-py 环境变量示例(复制为 .env 后填写;.env 不入库,本模板可入库)
# 启动期配置校验:非 dev 环境(DEBUG=false 或 LOGIN_MODE=real)下密钥不合规会直接拒绝启动
#   实现见 app/core/config.py: validate_startup_settings(DEV_FALLBACK_SECRETS / MIN_SECRET_LENGTH=32)
# ============================================================

# ---- 服务 ----
# 登录模式:mock=本地开发(固定mock_merchant_001);real=真实飞书OAuth。生产必须 real(否则未登录即可拿商家token,越权,见SEC-01)
LOGIN_MODE=mock
# DEBUG:生产必须 false。DEBUG=false 会同时关闭 /docs /redoc /openapi.json(接口文档端点)
DEBUG=true
# LOG_LEVEL:api 命名空间日志级别(**可选运维旋钮**;默认 INFO;生产可设 WARNING 降噪)。
# 只影响本服务的日志输出,不改任何业务行为(实现见 app/main.py::_configure_logging;幂等,只动 api logger)
LOG_LEVEL=INFO
HOST=127.0.0.1
# 实际监听端口以 uvicorn 启动参数为准(本项目统一 8000);该字段当前未被代码引用,改它不会改监听端口
PORT=8000

# ---- 数据库 ----
# 本地开发默认连本地 MySQL(merchant_task);生产/迁移目标连 Docker MySQL 服务器(库 merchant_task_prod)。
# 连接参数由部署方在 .env 中按真实值填写,此处仅为占位;生产禁止 root123 等 dev 兜底口令(启动期校验会拒绝启动)。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=change_me_db_password
DB_NAME=merchant_task
DB_ECHO=false

# ---- JWT(商家 token + 管理后台 token,两个不同 secret) ----
# 生产必须各生成一次随机强串填入(64 位 hex),两项必须不同:
#     openssl rand -hex 32
# 模板里的示例值一律不可用于生产:非 dev 环境下命中公开 dev 兜底值、长度 < 32、或两项相同,
# 服务都会在启动期配置校验中拒绝启动(app/core/config.py)。
JWT_SECRET=change_me_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=604800
ADMIN_JWT_SECRET=change_me_another_rand_hex
ADMIN_JWT_ALGORITHM=HS256
ADMIN_JWT_EXPIRES_IN=604800

# ---- 管理端登录失败锁定与登录请求限流(进程内内存态:多 worker/重启后失效;实现 app/services/auth.py) ----
# 连续失败达 ADMIN_LOGIN_MAX_ATTEMPTS 次锁定 ADMIN_LOGIN_LOCK_MINUTES 分钟;
# 登录请求限流 = 每 IP / 每用户名 各一份预算(ADMIN_LOGIN_RATE_MAX 次 / ADMIN_LOGIN_RATE_WINDOW_SECONDS 秒)
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCK_MINUTES=30
ADMIN_LOGIN_RATE_MAX=10
ADMIN_LOGIN_RATE_WINDOW_SECONDS=60

# ---- CORS(开发放开,生产收紧为具体域名白名单) ----
# 生产示例: CORS_ORIGINS=["https://your-frontend-domain.com"]
CORS_ORIGINS=["*"]

# ---- 可信代理(SEC-02) ----
# 仅当部署在可信反向代理(nginx)之后、且代理正确设置 X-Forwarded-For 时才置 true 并填 TRUSTED_PROXIES;
# 否则限流会取到代理 IP 而非真实客户端 IP。
TRUST_PROXY=false
TRUSTED_PROXIES=[]

# ---- AI 凭证(占位;生产由部署平台注入,勿入库真 key) ----
AI_API_KEY=your_ai_api_key
AI_BASE_URL=https://note3-prev-api.askdiandian.com/v1
AI_MODEL=dots3-note-prev
AI_TIMEOUT_MS=120000
AI_DAILY_LIMIT=3
# ---- AI 后台配置加密密钥(占位) ----
# AES-256-GCM,64 位 hex;生成:openssl rand -hex 32   每环境独立生成,禁止跨环境复用。
# 留空时:后台保存密钥会被拒绝(400);库中已有密文将回落 env(不报 500)。
AI_CONFIG_ENC_KEY=
# 轮换窗口期旧密钥槽位(可选):先上「新密钥 + PREVIOUS=旧密钥」→ 跑 scripts/rotate_ai_config_key.py → 移除 PREVIOUS
AI_CONFIG_ENC_KEY_PREVIOUS=
IMAGE_OPT_MAX_TOKENS=8000
IMAGE_OPT_TIMEOUT_MS=120000
IMAGE_OPT_MAX_CONCURRENCY=10
AI_IMAGE_OPT_DAILY_LIMIT=5
TITLE_OPT_MAX_TOKENS=4000
TITLE_OPT_TIMEOUT_MS=120000
TITLE_OPT_MAX_CONCURRENCY=10
AI_TITLE_OPT_DAILY_LIMIT=5

# ---- 飞书(占位;LOGIN_MODE=real 时缺失或占位会导致启动期校验拒绝启动) ----
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
H5_BASE_URL=http://127.0.0.1:5173

# ---- 静态资源(占位;把企微二维码放到该路径,文件名 advisor-qr.jpg) ----
# 相对 api-py 根目录;文件缺失时 GET /api/static/advisor-qr.jpg 返回结构化 404
ADVISOR_QR_FILE=static/advisor-qr.jpg

# ---- 商家手机号 + 短信验证码登录(阿里云号码认证 PNVS + 图形认证;占位,生产由部署方注入) ----
# 凭证:RAM 子账号最小权限(仅短信发送 + 验证码校验);生产只写服务器 api-py/.env(600),不入 git;禁止把真实 AK/SK 写入本模板
ALIYUN_SMS_ACCESS_KEY_ID=your_aliyun_sms_access_key_id
ALIYUN_SMS_ACCESS_KEY_SECRET=your_aliyun_sms_access_key_secret
ALIYUN_SMS_SIGN_NAME=your_sms_sign_name
ALIYUN_SMS_TEMPLATE_CODE=your_sms_template_code
# 接入点:必须为 dypnsapi.aliyuncs.com(号码认证服务 PNVS;写成 dysmsapi(短信服务产品)会 InvalidAction.NotFound → 统一 502)
ALIYUN_SMS_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_TIMEOUT_MS=5000
# 图形认证(人机校验)方案:未配置即 fail-closed(服务端二次校验一律不通过)
CAPTCHA_APP_ID=your_captcha_app_id
# 密钥:只进 .env(600),禁止日志/接口回显
CAPTCHA_APP_KEY=your_captcha_app_key
CAPTCHA_API_SERVER=https://captcha.alicaptcha.com
CAPTCHA_TIMEOUT_MS=3000

# ---- 验证码与频控矩阵(C1~C10;下列默认值可直接用,按业务需要调整) ----
# C9 有效期;同时作为短信模板中有效期占位符的取值(单一真源);C8 单码校验失败上限;C1 同手机号冷却
LOGIN_CODE_TTL_MINUTES=5
LOGIN_CODE_LENGTH=6
LOGIN_CODE_MAX_ATTEMPTS=5
LOGIN_CODE_COOLDOWN_SECONDS=60
# C2/C3 同手机号 时/日 上限;C4/C5 同 IP 时/日 上限;C6 全局日上限(80% 告警);C7 人机校验成本闸
LOGIN_CODE_PHONE_HOURLY_MAX=5
LOGIN_CODE_PHONE_DAILY_MAX=10
LOGIN_CODE_IP_HOURLY_MAX=20
LOGIN_CODE_IP_DAILY_MAX=60
LOGIN_CODE_GLOBAL_DAILY_MAX=1000
LOGIN_CAPTCHA_DAILY_MAX=3000
# C10 校验尝试窗口(分钟)与窗口内失败尝试上限
LOGIN_CODE_VERIFY_WINDOW_MINUTES=15
LOGIN_CODE_VERIFY_WINDOW_MAX=10

# ---- 内部通知(新商家注册 → 内部 IM 通道;失败绝不阻塞注册) ----
INTERNAL_NOTIFY_ENABLED=true
INTERNAL_NOTIFY_RECEIVE_ID_TYPE=open_id
# 接收方 ID:占位留空,部署时按真实值注入;禁止把真实 open_id 写进本模板/文档/日志/汇报
# 留空 = 未配置 → 内部通知显式跳过并记日志(不拒启动、不影响业务返回;源码默认值也是空串,#PB-37 A)
INTERNAL_NOTIFY_RECEIVE_ID=
INTERNAL_NOTIFY_TIMEOUT_MS=5000
