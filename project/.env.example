# 商家端 H5 环境变量示例（复制为 .env.development / .env.production 后填写）
# 提示：所有 VITE_* 变量都会被打进前端产物，**不要**在这里放任何密钥或机密。

# 后端 API 基址（部署时改成你的实际地址；本地开发可指向 127.0.0.1:8000）
VITE_API_BASE_URL=http://127.0.0.1:8000

# 登录方式：phone（手机号 + 短信验证码，推荐）/ feishu（飞书 OAuth）
VITE_LOGIN_MODE=phone

# 图形认证（人机校验）AppID：由阿里云图形认证控制台获取；属公开客户端标识，不是密钥
VITE_CAPTCHA_APP_ID=

# 飞书自建应用 AppID（仅 VITE_LOGIN_MODE=feishu 时需要；同样是公开标识）
VITE_FEISHU_APP_ID=
